@aicp v=semver:0.3.0 id=tomi-coder kind=skills summary="Three TDD development skills guided by an evidence-based interpretation of Tomi's style"
@stack lang=set[enum]:[markdown,python,lua,c,cpp,java] runtime=set[enum]:[python3] infra=set[enum]:[] package=list[path]:[] lock=list[path]:[]
@agent read=list[atom]:[@aicp,@stack,@mod,@resolver,@inv,@task] verify=bool:true update_on_arch_change=bool:true mode=guided
@avoid paths=list[glob]:[.git/**]
@mod documentation kind=docs owns=set[id]:[readme,base,evidence] entry=list[path]:[README.md,BASE.md,docs/style-and-evidence.md,docs/code-provenance.md] evidence=list[path]:[README.md,BASE.md,LICENSE]
@mod prepare kind=docs owns=set[id]:[skill-prepare] entry=list[path]:[skills/tomi-coder-prepare/SKILL.md] evidence=list[path]:[skills/tomi-coder-prepare/references/builders.md,skills/tomi-coder-prepare/references/tdd-example.md]
@mod develop kind=docs owns=set[id]:[skill-develop] entry=list[path]:[skills/tomi-coder-develop/SKILL.md] evidence=list[path]:[skills/tomi-coder-develop/references/ponytail.md,skills/tomi-coder-develop/references/PONYTAIL-LICENSE,skills/tomi-coder-develop/references/code-examples.md]
@mod construct kind=docs owns=set[id]:[skill-construct] entry=list[path]:[skills/tomi-code-construct/SKILL.md] evidence=list[path]:[skills/tomi-code-construct/references/review-example.md]
@mod packaging kind=cli owns=set[id]:[base-sync,checks] entry=list[path]:[scripts/sync_base.py,Makefile] test=list[path]:[tests/test_sync_base.py,tests/test_code_examples.py] evidence=list[path]:[scripts/sync_base.py,Makefile]
@surface prepare owner=prepare kind=skill visibility=public evidence=list[path]:[skills/tomi-coder-prepare/SKILL.md]
@surface develop owner=develop kind=skill visibility=public evidence=list[path]:[skills/tomi-coder-develop/SKILL.md]
@surface construct owner=construct kind=skill visibility=public evidence=list[path]:[skills/tomi-code-construct/SKILL.md]
@resolver edit-base target=mod.documentation intent=edit go=list[path]:[BASE.md,docs/style-and-evidence.md,README.md] use=list[enum]:[search,tests] verify=list[string]:["make sync-base","make check","git diff --check"]
@resolver edit-prepare target=mod.prepare intent=edit go=list[path]:[skills/tomi-coder-prepare/SKILL.md,skills/tomi-coder-prepare/references/builders.md,skills/tomi-coder-prepare/references/tdd-example.md] use=list[enum]:[search,tests] verify=list[string]:["make check","git diff --check"]
@resolver edit-develop target=mod.develop intent=edit go=list[path]:[skills/tomi-coder-develop/SKILL.md,skills/tomi-coder-develop/references/ponytail.md,skills/tomi-coder-develop/references/code-examples.md] use=list[enum]:[search,tests] verify=list[string]:["make check","git diff --check"]
@resolver edit-construct target=mod.construct intent=edit go=list[path]:[skills/tomi-code-construct/SKILL.md,skills/tomi-code-construct/references/review-example.md] use=list[enum]:[search,tests] verify=list[string]:["make check","git diff --check"]
@resolver edit-packaging target=mod.packaging intent=edit go=list[path]:[tests/test_sync_base.py,tests/test_code_examples.py,scripts/sync_base.py,Makefile] use=list[enum]:[search,tests] verify=list[string]:["make check"]
@contract phase-handoff source=list[path]:[BASE.md] summary="Observable contract, module responsibilities, tools, commands, RED/GREEN evidence, limits, and next stage; use an existing record or TOMI-TASK.md when needed"
@flow development steps=list[id]:[prepare,develop,construct] evidence=list[path]:[BASE.md]
@inv example-provenance scope=set[id]:[documentation,prepare,develop,construct] rule="Example clones were removed after extraction; preserve adapted excerpts, limits, attribution, and source identities without requiring the clones" evidence=list[path]:[docs/code-provenance.md,docs/style-and-evidence.md]
@inv base-copies scope=set[id]:[packaging,prepare,develop,construct] rule="The root BASE.md is canonical; skill references are exact copies generated by the synchronizer" enforce=list[path]:[scripts/sync_base.py,tests/test_sync_base.py]
@inv tdd scope=set[id]:[prepare,develop,construct] rule="New or corrected behavior requires a prior test and observed RED before implementation; behavior-preserving characterization may begin green" evidence=list[path]:[BASE.md]
@inv licensing scope=set[id]:[develop] rule="Distribute the Ponytail adaptation with its MIT notice and preserve the project's Apache-2.0 license" evidence=list[path]:[LICENSE,skills/tomi-coder-develop/references/PONYTAIL-LICENSE,README.md]
@inv example-licenses scope=set[id]:[prepare,develop,construct] rule="Derived excerpts retain original MIT notices; anonymized code does not erase attribution" evidence=list[path]:[skills/tomi-coder-prepare/references/EXAMPLES-LICENSE,skills/tomi-coder-develop/references/EXAMPLES-LICENSE,skills/tomi-code-construct/references/EXAMPLES-LICENSE]
@cmd check run="make check" evidence=list[path]:[Makefile,tests/test_sync_base.py]
@cmd sync-base run="make sync-base" evidence=list[path]:[Makefile,scripts/sync_base.py]
@artifact base-copies source=BASE.md paths=list[path]:[skills/tomi-coder-prepare/references/BASE.md,skills/tomi-coder-develop/references/BASE.md,skills/tomi-code-construct/references/BASE.md] generated=bool:true
@risk style-inference level=medium scope=set[id]:[documentation] mitigation="Separate historical observations from current requirements; do not misattribute collaborators' work or infer TDD from commit titles"
@note validation-limits text="Checks cover synchronization, CLI, and Markdown excerpts. Excerpt tests require Lua, GCC, G++, and a JDK; missing tools cause explicit skips. Skill format can be checked with skill-creator quick_validate.py; no automated agent-behavior evaluation exists."
@note examples text="Five MIT projects provided excerpts; LicensePicker remains architectural evidence only because its application license is uncertain. The extraction record replaces reliance on six local clones."
